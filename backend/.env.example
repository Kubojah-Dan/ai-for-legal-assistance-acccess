# NyayaMitra Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Use a JSON array. Add the Vercel production URL before deploying.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Groq AI API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GROQ_MODEL_LARGE=llama-3.3-70b-versatile

# Upstash Redis for Sliding-Window Rate Limiting & Cache
UPSTASH_REDIS_REST_URL=https://your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
REDIS_URL=redis://localhost:6379/0

# Supabase pgvector for Legal Corpus RAG
SUPABASE_URL=https://your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Legal Compliance
LEGAL_YEAR_ENFORCED=2024
REJECT_REPEALED_IPC=true
MAX_REQUESTS_PER_MINUTE=30
